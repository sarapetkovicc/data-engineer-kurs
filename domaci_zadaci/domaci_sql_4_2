    select team_id
    from teams
    where team_name = 'Northport United'
)
select avg(m.attendance) as prosek, avg(m.attendance * 100 / s.capacity) as procenat_popunjenost,
count(case when m.attendance is null then 1 end ) bez_podataka
from matches m join club c on m.home_team_id = c.team_id or m.away_team_id = c.team_id
