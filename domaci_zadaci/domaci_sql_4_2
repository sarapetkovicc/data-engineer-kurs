-- Prvi zadatak
with club as (
    select team_id
    from teams
    where team_name = 'Northport United'
),
rezultati as (
    select m.match_id,
    case when c.team_id = m.home_team_id then m.home_goals
    else m.away_goals end as dati,
    case when c.team_id = m.home_team_id then m.away_goals
    else m.home_goals end as primljeni,
    case when (c.team_id = m.home_team_id and m.home_goals > m.away_goals) or (c.team_id = m.away_team_id and m.away_goals > m.home_goals) then 3
    when (c.team_id = m.home_team_id and m.home_goals = m.away_goals) or (c.team_id = m.away_team_id and m.away_goals = m.home_goals) then 1
    else 0 end as bodovi
    from matches m join club c
    on m.home_team_id = c.team_id  or m.away_team_id = c.team_id
    where m.season = '2024/25'
)
select count(*) as utakmice, sum(case when dati > primljeni then 1 else 0 end) pobeda,
sum (case when primljeni > dati then 1 else 0 end) gubitak,
sum(case when dati = primljeni  then 1 else 0 end) nereseno,
sum(dati) dati,
sum(primljeni) primljeni,
sum(bodovi) as bodovi
from rezultati

